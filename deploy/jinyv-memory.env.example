# Jinyv-memory 生产环境变量模板（复制到 /etc/jinyv-memory.env，勿提交真实值）
# 模型
RP_FRONT_KEY=
RP_FRONT_MODEL=
RP_BACK_KEY=
RP_BACK_MODEL=
RP_LLM_BASE=

# 插件仓库（单一仓库）
JINYV_PLUGIN_PATHS=/opt/jinyv-plugins
JINYV_DATA_DIR=/opt/jinyv-memory/var
JINYV_SECRETS_DIR=/opt/jinyv-memory/secrets

# 宿主 HTTP API
JINYV_HOST_API_TOKEN=

# 桌宠 / 通话
JINYV_DESKTOP_TOKEN=
JINYV_VIDEO_CALL_TOKEN=

# 桌宠 / 通话的记忆核心接入：embedded（同进程）| local（本机）| server（远程）
# 独立运行桌宠服务时，可用 desktop-pet/standalone.py 连本机或远程核心。
JINYV_PLUGIN_DESKTOP_PET_CORE_MODE=embedded
JINYV_PLUGIN_DESKTOP_PET_CORE_URL=http://127.0.0.1:8710
JINYV_PLUGIN_VIDEO_CALL_CORE_MODE=embedded
JINYV_PLUGIN_VIDEO_CALL_CORE_URL=http://127.0.0.1:8710

# 通话服务自身地址（本地服务或远程服务器）
JINYV_PLUGIN_VIDEO_CALL_SERVICE_URL=http://127.0.0.1:8790
