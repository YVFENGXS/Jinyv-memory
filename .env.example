# ---------------- NoneBot2 本体 ----------------
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
# 与 NapCat「反向 WS」里填的 Token 保持一致
ONEBOT_ACCESS_TOKEN=change-me

# ---------------- 模型 ----------------
# 必填。密钥只放 .env / 环境变量，不要写进代码，也不要提交仓库。
RP_FRONT_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RP_BACK_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RP_FRONT_MODEL=deepseek-flash
# RP_BACK_MODEL=deepseek-flash
# RP_FRONT_THINKING=off        # off 关闭思考；留空用服务端默认
# RP_BACK_THINKING=off         # 后台归纳/打标不需要思考，建议 off
# RP_LLM_BASE=https://api.deepseek.com

# ---------------- 记忆体 ----------------
# 相对路径基于启动时的工作目录；服务器上建议用绝对路径（如 /opt/qqbot/data/rp_memory.db）
RP_DB=./data/rp_memory.db
RP_MAX_TOKENS=64000          # 前台模型的上下文窗口，不是输出上限
RP_OUTPUT_RESERVE=4096
RP_PROFILE=cl100k            # DeepSeek 保守估；Qwen 用 qwen，GLM 用 zhipu
RP_COOLDOWN=2                # 同一会话冷却秒数
# 闲置多少小时后自动开新会话（旧的标 closed，strict 承诺/长期事实继承）；0=不轮换
RP_SESSION_EPOCH_HOURS=48
RP_EPOCH_FLUSH_SECONDS=8
# 每轮最多注入几张召回卡（钩子 + 语义混合召回后的上限）
RP_RECALL_CARDS=4
# cue→card 联想缓存：同一 cue 再次命中时直接出卡，省一次后台联想调用；0=关闭
RP_ASSOC_CACHE=1

# ---------------- 富消息 ----------------
# 模型可用标记：[[img:https://...]] [[face:14]] [[sticker:标签]] [[voice:要说的话]] [[search:关键词]]
RP_RICH=1
RP_IMG_MAX_MB=15             # 单张图片下载上限（QQ 大 GIF 常见 6~12MB）
RP_IMG_TEXT_LIMIT=4000       # 视觉判读抄录图中文字的上限（字符）；截图/文档调大后能读全
RP_IMG_NOTE_TEXT=4000        # OCR 注入前台的字数上限；调小可省 token
RP_STICKER_DIR=./stickers
RP_TTS_DIR=./tts_cache
RP_TTS_VOICE=zh-CN-XiaoyiNeural
RP_TTS_MAX_MB=200            # TTS 缓存容量上限
RP_TTS_MAX_AGE_DAYS=7        # 超过天数先删

# ---------------- 贴纸自学习 ----------------
RP_AUTOSTICKER=1
RP_AUTOSTICKER_DAILY=5       # 普通群友每日自动入库上限；管理员发图不受限
RP_TAG_MODEL=deepseek-flash

# ---------------- 主动交互 ----------------
RP_IDLE_NUDGE_MINUTES=60     # 私聊闲置多久后主动开口，0=关闭
RP_PROACTIVE=1               # 1=由模型按记忆生成开场白，0=只用下面的固定文案
RP_PROACTIVE_DAILY=3         # 每个会话每天最多主动开口几次
# RP_IDLE_NUDGE_TEXT=固定文案（模型生成失败时兜底）
RP_POKE_BACK=1               # 1=被戳时回戳
RP_POKE_COOLDOWN=30          # 同一个人两次戳之间的最小间隔（秒）

# ---------------- 语音转文字（SiliconFlow SenseVoice） ----------------
RP_ASR=1                     # 0=关闭；没配 RP_ASR_KEY 时也不会生效
RP_ASR_KEY=                  # 硅基流动密钥
# RP_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
# RP_ASR_BASE=https://api.siliconflow.cn/v1

# ---------------- 语义召回（SiliconFlow BAAI/bge-m3） ----------------
# DeepSeek 没有 embeddings 接口：语义召回默认走硅基流动，密钥回退用 RP_ASR_KEY
RP_EMBED=1                   # 0=只用实体钩子召回；没配密钥时不生效
RP_EMBED_KEY=                # 硅基流动密钥；留空则用上面的 RP_ASR_KEY
# RP_EMBED_MODEL=BAAI/bge-m3 # 1024 维；换模型必须同步改 RP_EMBED_DIM 并清空 vectors 表
# RP_EMBED_BASE=https://api.siliconflow.cn/v1
# RP_EMBED_DIM=1024
# RP_EMBED_BATCH=16
# RP_EMBED_TIMEOUT=15

# ---------------- 链接 / 视频 ----------------
RP_LINK=1                    # 1=消息里带链接就抓正文；0=关闭
RP_VIDEO_DAILY=3             # 视频抽帧每日上限（管理员不受限）
# 主动看B站：模型可自己 search/popular/watch；搜索类每天有次数上限
RP_BILI_TOOL=1
RP_BILI_LIST_DAILY=30
# B站账号管理（需 /bili login 扫码）：评论额度、间隔、字数上限
RP_BILI_CMT_DAILY=3          # 每天最多发几条视频评论；0=关闭
RP_BILI_CMT_GAP=600          # 两条评论最小间隔秒数
RP_BILI_CMT_CHARS=100        # 单条评论字数上限
RP_BILI_OWNER_UID=10001   # 主人自己的B站 UID
RP_BILI_OWNER_NAME=小主人     # 主人B站昵称；配置后评论只放行 @主人
# RP_VIDEO_MAX_SECONDS=300   # 超过这个时长只读标题/简介，不抽帧
# RP_VIDEO_WINDOW_SECONDS=180  # 4 分钟以上的视频按这个窗口分段读，每段 6 格
# RP_VIDEO_MAX_WINDOWS=3     # 长视频最多读几段
# RP_VIDEO_INDEX_CHARS=800   # 每格台词合并后注入的字数上限
# RP_VIDEO_CACHE_HOURS=24    # 同一视频多久内直接回放上次观察；0=关闭（video_zoom 也随之失效）
# RP_VIDEO_CACHE_DIR=/opt/qqbot/cache/video  # 观察文本 + 视频副本的缓存目录
# 视频分镜（第三方 dsh-video-storyboard，用 deploy/install_storyboard.sh 安装）
# 装了就用一张拼图一次判读代替四帧四次判读；留空=自动检测
# RP_STORYBOARD=1
# RP_STORYBOARD_DIR=/opt/qqbot/vendor/dsh-video-storyboard
# RP_STORYBOARD_CELLS=9

# ---------------- 签名 / QQ空间 ----------------
# 模型只在和管理员聊到情绪激动/情真意切时才会换签名；只在遇到有趣的事时发说说
RP_SIGN=1
RP_SIGN_COOLDOWN_HOURS=24    # 两次改签名的最小间隔
RP_QZONE=1
RP_QZONE_DAILY=1             # 每天最多几条说说
RP_QZONE_GAP_HOURS=6         # 两条说说之间的最小间隔
RP_QZONE_RIGHT=4             # 1公开 / 4仅好友 / 16部分好友 / 64仅自己

# ---------------- 定时提醒 ----------------
# 提醒到点投递后，过多少秒由后台复查前台有没有真的执行（发说说/搜图/发消息）；
# 已执行就取消复查，没执行就再叫它补做一次。0=关闭复查
RP_REMIND_CHECK_SECONDS=120

# ---------------- 词条 / 事件卡合并 ----------------
# 每隔几小时让后台模型判断重复词条、重复事件卡并合并（信息最全的优先保留，
# 过时事实会并成「（日期）原…；（日期）现在…」的时间线陈述）
RP_FACT_MERGE_HOURS=6
RP_FACT_MERGE_MIN=20         # 会话事实达到多少条才自动合并
RP_CARD_MERGE_MIN=8          # 会话事件卡达到多少张才自动合并

# ---------------- 图激活（一跳） ----------------
# 用已命中卡的实体钩子补 1~2 张邻居卡（分恒低于种子，挤不掉 top-1）；
# 只在多跳线索或字面很弱时激活。线上默认 0：真实语料 A/B 无增益（见 benchmark 4.11）
RP_GRAPH=0

# ---------------- Dream 轻量整理 ----------------
# 每天固定时刻收走过期临时事实 + 合并同义词条；0=关闭
RP_DREAM=1
RP_DREAM_AT=03:30            # 本地时间 HH:MM
RP_DREAM_SESSIONS=8          # 单次最多整理多少个会话

# ---------------- 社交圈（默认关闭） ----------------
# /social on 开启：所有群+私聊共用一份全局记忆，独立 db，按人记词条和好感度
# 关闭时回到每个群/私聊各自分离的记忆；两套记忆互不合并
RP_SOCIAL_AFFINITY_HOURS=3   # 每隔几小时复盘一次好感度

# ---------------- 管理命令 ----------------
# 允许 /save /tags /find /img /sticker /voice /testrich /new /merge /memory
# /persona /social 的 QQ 号（逗号分隔）
RP_ADMIN_QQ=
