# 瑾瑜记忆中间层（core）环境变量示例
# 平台接入（QQ/KOOK/桌宠/通话）的变量在 Jinyv-plugins 的 qqbot/env.example。

# ---- 模型 ----
RP_FRONT_KEY=
RP_BACK_KEY=
RP_FRONT_MODEL=deepseek-chat
RP_BACK_MODEL=deepseek-chat
RP_LLM_BASE=https://api.deepseek.com/v1
RP_FALLBACK_KEY=
RP_FALLBACK_FRONT_MODEL=
RP_FALLBACK_BACK_MODEL=

# ---- 记忆库与预算 ----
RP_DB=data/rp_memory.db
RP_MAX_TOKENS=64000
RP_OUTPUT_RESERVE=4096
RP_PROFILE=cl100k
RP_CONTEXT_WORK_BUDGET=65536
RP_RECALL_CARDS=4

# ---- 宿主 HTTP（tools/serve.py）----
RP_HOST_TOKEN=
RP_HOST_SESSION=host-main

# ---- 输出中间层（确定性，不靠 prompt）----
RP_STYLE_MIDDLE=1
RP_STYLE_BESTN=2
RP_STYLE_JSONL=1
RP_STYLE_DUP_RATIO=0.55
RP_STYLE_ACTION=strict

# ---- 压缩 / 轮换 / Dream ----
RP_COMPRESSION_ENABLED=0
RP_COMPRESSION_SHADOW=1
RP_SESSION_EPOCH_HOURS=48
RP_EPOCH_FLUSH_SECONDS=8
RP_DREAM=1
RP_DREAM_AT=03:30
RP_DREAM_SESSIONS=8

# ---- 语义召回（可选）----
RP_EMBED=1
RP_EMBED_KEY=
RP_EMBED_MODEL=BAAI/bge-m3
RP_EMBED_BASE=https://api.siliconflow.cn/v1
RP_EMBED_DIM=1024
