# 模型与运行时密钥（不要提交）
RP_FRONT_KEY=
RP_FRONT_MODEL=
RP_BACK_KEY=
RP_BACK_MODEL=
RP_LLM_BASE=

# 运行数据与密钥目录
# JINYV_DATA_DIR=./var
# JINYV_SECRETS_DIR=./secrets
# 离线自检：JINYV_LLM_MOCK=1

# QQ 插件可选消息入口
# JINYV_PLUGIN_QQBOT_NONEBOT=auto

# 插件搜索路径（Windows 用 ; 分隔；留空读 config/core.toml）
# JINYV_PLUGIN_PATHS=E:\Jinyv-plugins

# QQ 旧能力只读桥（过渡）；留空不启用
# JINYV_QQBOT_LEGACY_DIR=E:\rp_memory_project\jinyu-memory\jinyu_memory

# 桌宠 / 视频通话独立仓库目录（适配层只检测，不复制源码）
# JINYV_DESKTOP_PET_DIR=
# JINYV_VIDEO_CALL_DIR=

# DSH 改造版与第三方分镜
# DSH_HOME=%USERPROFILE%\.dsh
# RP_STORYBOARD_DIR=
