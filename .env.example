# ---------------- NoneBot2 本体 ----------------
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
# 与 NapCat「反向 WS」里填的 Token 保持一致
ONEBOT_ACCESS_TOKEN=change-me

# ---------------- 模型 ----------------
# 必填。密钥只放 .env / 环境变量，不要写进代码，也不要提交仓库。
RP_FRONT_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RP_BACK_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RP_FRONT_MODEL=deepseek-flash
# RP_BACK_MODEL=deepseek-flash
# RP_FRONT_THINKING=off        # off 关闭思考；留空用服务端默认
# RP_BACK_THINKING=off         # 后台归纳/打标不需要思考，建议 off
# RP_LLM_BASE=https://api.deepseek.com

# ---------------- 记忆体 ----------------
# 相对路径基于启动时的工作目录；服务器上建议用绝对路径（如 /opt/qqbot/data/rp_memory.db）
RP_DB=./data/rp_memory.db
RP_MAX_TOKENS=64000          # 前台模型的上下文窗口，不是输出上限
RP_OUTPUT_RESERVE=4096
RP_PROFILE=cl100k            # DeepSeek 保守估；Qwen 用 qwen，GLM 用 zhipu
RP_COOLDOWN=2                # 同一会话冷却秒数
# 闲置多少小时后自动开新会话（旧的标 closed，strict 承诺/长期事实继承）；0=不轮换
RP_SESSION_EPOCH_HOURS=48
RP_EPOCH_FLUSH_SECONDS=8

# ---------------- 富消息 ----------------
# 模型可用标记：[[img:https://...]] [[face:14]] [[sticker:标签]] [[voice:要说的话]] [[search:关键词]]
RP_RICH=1
RP_IMG_MAX_MB=15             # 单张图片下载上限（QQ 大 GIF 常见 6~12MB）
RP_STICKER_DIR=./stickers
RP_TTS_DIR=./tts_cache
RP_TTS_VOICE=zh-CN-XiaoyiNeural
RP_TTS_MAX_MB=200            # TTS 缓存容量上限
RP_TTS_MAX_AGE_DAYS=7        # 超过天数先删

# ---------------- 贴纸自学习 ----------------
RP_AUTOSTICKER=1
RP_AUTOSTICKER_DAILY=5       # 普通群友每日自动入库上限；管理员发图不受限
RP_TAG_MODEL=deepseek-flash

# ---------------- 闲置提醒（仅私聊） ----------------
RP_IDLE_NUDGE_MINUTES=60     # 0=关闭
# RP_IDLE_NUDGE_TEXT=自定义提醒语

# ---------------- 管理命令 ----------------
# 允许 /save /tags /find /img /sticker /voice /testrich /new 的 QQ 号（逗号分隔）
RP_ADMIN_QQ=
