# Satori 侧车配置模板
# 用法：复制成 platform/.env（已被 .gitignore 的 .env 规则忽略），
#       sidecar 启动前用 `set -a; . platform/.env; set +a` 或 systemd EnvironmentFile 载入。
# 注意：不要把真实 token 写进本模板或提交到仓库。

# ---- Satori 服务端（Koishi 里的 @satorijs/plugin-server）----
# 只监听本机，不对公网开放；端口要和 deploy/koishi/koishi.yml 一致。
SATORI_HOST=127.0.0.1
SATORI_PORT=5140
# 与 koishi.yml 中 server.token 相同；留空表示该 Satori 实例不校验 token（仅本机可接受）
SATORI_TOKEN=
# 事件里用于取平台能力的名字，阶段一是 kook
SATORI_PLATFORM=kook

# ---- 宿主接口（现有 QQ 主进程，不新增接口）----
JINYU_HOST=http://127.0.0.1:8080
# 复用主进程的 RP_HOST_TOKEN；缺这一项侧车不会启动
JINYU_TOKEN=
# 宿主接口只认 qq / desk / video 三种来源，KOOK 阶段一借用 qq 标签
JINYU_SOURCE=qq

# ---- KOOK 凭据（给 Koishi 的 adapter-kook 用，sidecar 本身不读）----
# 开发者后台 > 应用 > 机器人 > Token
KOOK_TOKEN=
# 机器人所在服务器 id（KOOK 客户端里右键服务器「复制服务器 ID」）
KOOK_SERVER_ID=
# 你的 KOOK 用户 id（用于第一轮私聊验收）
KOOK_OWNER_ID=

# ---- 访问控制（可选）----
# 逗号分隔的 KOOK 用户 id 白名单；留空表示不限制（本机私聊场景可先留空）
KOOK_ALLOW_USERS=

# ---- QQ 掉线兜底（可选）----
# 宿主 QQ 账号离线/发送失败时，主动消息、提醒、作息发文改发到这里。
# 频道 id：KOOK 客户端里右键频道「复制频道 ID」；留空则兜底接口返回 503，不影响正常收发。
KOOK_FALLBACK_CHANNEL=
# 兜底发送口只监听 127.0.0.1；宿主用 RP_KOOK_SEND_URL 指向它（默认就是这个端口）
KOOK_SEND_PORT=8099
